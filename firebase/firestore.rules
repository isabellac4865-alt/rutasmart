rules_version = '2';
// Reglas de Firestore del proyecto RutaSmart (rutasmart-10006).
// Pegar TODO este archivo en Firebase > Firestore Database > Reglas > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    // ¿Quien hace la petición es administrador?
    // Sí, si inició sesión con admin@rutasmart.com, o si existe admins/{uid} (creado a mano en la consola).
    function esAdmin() {
      return request.auth != null
        && (request.auth.token.email == 'admin@rutasmart.com'
            || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // Lista de administradores: cada uno solo puede comprobar SU propio documento. Nadie la modifica desde la app.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Estado del servicio (líneas suspendidas + aviso): lo leen todos, solo el admin lo publica.
    match /config/servicio {
      allow read: if true;
      allow write: if esAdmin()
        && request.resource.data.keys().hasOnly(['lineasSuspendidas', 'aviso', 'nivel', 'actualizadoMillis', 'actualizadoPor'])
        && request.resource.data.lineasSuspendidas is list && request.resource.data.lineasSuspendidas.size() <= 20
        && request.resource.data.aviso is string && request.resource.data.aviso.size() <= 200
        && request.resource.data.nivel in ['INFO', 'ALERTA', 'URGENTE']
        && request.resource.data.actualizadoPor == request.auth.uid;
    }

    // Estadísticas: el admin puede LEER (no modificar) las consultas de todos (consulta de grupo).
    match /{ruta=**}/consultas/{consultaId} {
      allow read: if esAdmin();
    }

    // Cada usuario solo puede leer y escribir SU documento (preferencias) y SU historial.
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /consultas/{consultaId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.origen is string && request.resource.data.origen.size() <= 80
          && request.resource.data.destino is string && request.resource.data.destino.size() <= 80
          && request.resource.data.puntaje is number
          && request.resource.data.puntaje >= 0 && request.resource.data.puntaje <= 100
          && request.resource.data.costo is int && request.resource.data.costo >= 0;
      }
    }

    // Todo lo demás está cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
